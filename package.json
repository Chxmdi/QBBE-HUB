{
  "name": "qbbe-hub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "QBBE Hub — the Quebec Board of Black Educators' internal operating and communication system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mfa": "playwright test mfa --project=chromium",
    "test:e2e:realtime": "playwright test realtime-revocation --project=chromium",
    "test:qa": "playwright test qa-matrix",
    "test:a11y": "playwright test public-routes",
    "test:db": "node scripts/test-db.mjs",
    "db:seed": "node scripts/seed-local.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "qa:realtime-latency": "node scripts/qa/realtime-latency.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.510.0",
    "next": "^16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wait-on": "^9.1.0"
  }
}
