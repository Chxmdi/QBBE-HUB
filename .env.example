# QBBE Hub environment variables.
# Copy to .env.local for development. Never commit real values.
# Every secret lives in environment-specific secret management (Vercel/Supabase),
# only NEXT_PUBLIC_* values may reach the browser. (ENV-003, ENV-004)

# --- Application ---
# Canonical application URL used for safe client links and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
# Project URL from the Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe to expose only because Row Level Security is the
# real authorization boundary on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key. NEVER expose to the browser or client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Gmail / Calendar integrations, optional until Phase 4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact allowed callback URL for this environment.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Transactional email ---
# Resend API key. Leave blank and the pipeline still runs end to end, logging
# each message instead of sending it (Admin -> Email says so plainly).
EMAIL_PROVIDER_API_KEY=
# Verified QBBE-controlled sender address, e.g. "QBBE Hub <hub@qbbe.org>".
EMAIL_FROM_ADDRESS=

# --- Observability (optional) ---
ERROR_MONITORING_DSN=

# --- Scheduled jobs ---
# Shared secret protecting /api/jobs/*. Minimum 32 characters; generate with
# `openssl rand -base64 48`. The database must hold the same value:
#   select app.configure_job_runner('https://<domain>', '<this secret>');
# See docs/runbooks/jobs.md.
CRON_JOB_SECRET=
