# QBBE Hub environment variables.
# Copy to .env.local for development. Never commit real values.
# Every secret lives in environment-specific secret management (Vercel/Supabase),
# only NEXT_PUBLIC_* values may reach the browser. (ENV-003, ENV-004)

# --- Application ---
# Canonical application URL used for safe client links and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
# Project URL from the Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe to expose only because Row Level Security is the
# real authorization boundary on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key. NEVER expose to the browser or client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Gmail / Calendar integrations, optional until credentials exist) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact allowed callback URL for this environment.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Gmail Push: a fully-qualified Pub/Sub topic in the same Google Cloud project.
# Configure an authenticated push subscription with the endpoint below as the
# audience and a dedicated service account; no shared secret belongs in its URL.
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_PUBSUB_AUDIENCE=https://your-domain.example/api/integrations/gmail/push
GOOGLE_GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# --- Volunteer Management System (optional; Hub does not own volunteer records) ---
VMS_API_URL=
VMS_API_KEY=

# --- Transactional email ---
# Resend API key. Leave blank and the pipeline still runs end to end, logging
# each message instead of sending it (Admin -> Email says so plainly).
EMAIL_PROVIDER_API_KEY=
# Verified QBBE-controlled sender address, e.g. "QBBE Hub <hub@qbbe.org>".
EMAIL_FROM_ADDRESS=
# Local Mailpit (supabase start): SMTP 54325, UI 54324.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# --- Observability (optional) ---
ERROR_MONITORING_DSN=

# --- Scheduled jobs ---
# Shared secret protecting /api/jobs/*. Minimum 32 characters; generate with
# `openssl rand -base64 48`. The database must hold the same value:
#   select app.configure_job_runner('https://<domain>', '<this secret>');
# See docs/runbooks/jobs.md.
CRON_JOB_SECRET=
# Vercel Cron also sends Authorization: Bearer $CRON_SECRET — set both to the same value.
CRON_SECRET=
