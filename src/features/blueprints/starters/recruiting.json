      ],
      "layout": {
        "x": 600,
        "y": 40
      }
    }
  ],
  "relations": [
    {
      "key": "applies_for",
      "from": "candidate",
      "to": "job_opening",
      "name": {
        "en": "applies for",
        "fr": "postule à"
      },
      "reverseName": {
        "en": "applicants",
        "fr": "candidatures"
      },
      "cardinality": "many_to_many"
    },
    {
      "key": "interview_of",
      "from": "interview",
      "to": "candidate",
      "name": {
        "en": "interviews",
        "fr": "fait passer une entrevue à"
      },
      "reverseName": {
        "en": "interviews",
        "fr": "entrevues"
      },
      "cardinality": "one_to_many"
    }
  ],
  "lenses": [
    {
      "key": "interview_calendar",
      "type": "interview",
      "kind": "calendar",
      "name": {
        "en": "Interview calendar",
        "fr": "Calendrier des entrevues"
      },
      "groupBy": "scheduled_for"
    }
  ],
  "forms": [
    {
      "key": "application_form",
      "type": "candidate",
      "name": {
        "en": "Apply",
        "fr": "Postuler"
      },
      "fields": [
        "title",
        "email",
        "phone",
        "resume",
        "applied_for"
      ]
    }
  ],
  "workflows": [
    {
      "key": "new_candidate",
      "type": "candidate",
      "name": {
        "en": "New candidate",
        "fr": "Nouvelle candidature"
      },
      "trigger": {
        "on": "created"
      },
      "steps": [
        {
          "kind": "create_task",
          "title": {
            "en": "Screen the application",
            "fr": "Présélectionner la candidature"
          },
          "dueInDays": 3
        }
      ]
    },
    {
      "key": "candidate_hired",
      "type": "candidate",
      "name": {
        "en": "Candidate hired",
        "fr": "Candidat embauché"
      },
      "trigger": {
        "on": "property_changed",
        "property": "stage",
        "to": "hired"
      },
      "steps": [
        {
          "kind": "create_task",
          "title": {
            "en": "Start onboarding",
            "fr": "Commencer l’accueil"
          },
          "dueInDays": 5
        },
        {
          "kind": "notify",
          "role": "admin",
          "message": {
            "en": "A candidate was hired.",
            "fr": "Un candidat a été embauché."
          }
        }
      ]
    }
  ]
}
