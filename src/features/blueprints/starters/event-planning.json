  "relations": [
    {
      "key": "session_of",
      "from": "event_session",
      "to": "planned_event",
      "name": {
        "en": "is part of",
        "fr": "fait partie de"
      },
      "reverseName": {
        "en": "sessions",
        "fr": "séances"
      },
      "cardinality": "one_to_many"
    },
    {
      "key": "speaks_at",
      "from": "speaker",
      "to": "event_session",
      "name": {
        "en": "speaks at",
        "fr": "présente"
      },
      "reverseName": {
        "en": "speakers",
        "fr": "conférenciers"
      },
      "cardinality": "many_to_many"
    },
    {
      "key": "registered_for",
      "from": "registration",
      "to": "planned_event",
      "name": {
        "en": "is for",
        "fr": "concerne"
      },
      "reverseName": {
        "en": "registrations",
        "fr": "inscriptions"
      },
      "cardinality": "one_to_many"
    }
  ],
  "lenses": [
    {
      "key": "event_calendar",
      "type": "planned_event",
      "kind": "calendar",
      "name": {
        "en": "Event calendar",
        "fr": "Calendrier des événements"
      },
      "groupBy": "starts_on"
    }
  ],
  "forms": [
    {
      "key": "event_registration",
      "type": "registration",
      "name": {
        "en": "Register",
        "fr": "S’inscrire"
      },
      "fields": [
        "title",
        "email",
        "event"
      ]
    }
  ],
  "workflows": [
    {
      "key": "event_confirmed",
      "type": "planned_event",
      "name": {
        "en": "Event confirmed",
        "fr": "Événement confirmé"
      },
      "trigger": {
        "on": "property_changed",
        "property": "status",
        "to": "confirmed"
      },
      "steps": [
        {
          "kind": "create_task",
          "title": {
            "en": "Send the invitations",
            "fr": "Envoyer les invitations"
          },
          "dueInDays": 7
        },
        {
          "kind": "create_task",
          "title": {
            "en": "Book the room and catering",
            "fr": "Réserver la salle et le traiteur"
          },
          "dueInDays": 14
        }
      ]
    }
  ]
