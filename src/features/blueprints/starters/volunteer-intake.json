              }
            },
            {
              "key": "weekends",
              "label": {
                "en": "Weekends",
                "fr": "Fins de semaine"
              }
            }
          ]
        },
        {
          "key": "languages",
          "name": {
            "en": "Languages",
            "fr": "Langues"
          },
          "kind": "multi_select",
          "choices": [
            {
              "key": "english",
              "label": {
                "en": "English",
                "fr": "Anglais"
              }
            },
            {
              "key": "french",
              "label": {
                "en": "French",
                "fr": "Français"
              }
            }
          ]
        },
        {
          "key": "background_check",
          "name": {
            "en": "Background check done",
