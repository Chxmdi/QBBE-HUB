            {
              "key": "full",
              "label": {
                "en": "Full",
                "fr": "Complet"
              }
            },
            {
              "key": "done",
              "label": {
                "en": "Done",
                "fr": "Terminé"
              }
            }
          ]
        },
        {
          "key": "volunteers",
          "name": {
            "en": "Volunteers",
            "fr": "Bénévoles"
          },
          "kind": "relation",
          "relation": "signed_up_for"
        }
      ],
      "layout": {
        "x": 360,
        "y": 40
      }
    }
  ],
  "relations": [
    {
      "key": "signed_up_for",
      "from": "volunteer",
      "to": "volunteer_shift",
      "name": {
        "en": "signed up for",
        "fr": "inscrit à"
      },
      "reverseName": {
        "en": "volunteers",
        "fr": "bénévoles"
      },
      "cardinality": "many_to_many"
    }
  ],
  "lenses": [
    {
      "key": "shift_calendar",
      "type": "volunteer_shift",
      "kind": "calendar",
      "name": {
        "en": "Shift calendar",
        "fr": "Calendrier des quarts"
      },
      "groupBy": "starts_on"
    }
  ],
  "forms": [
    {
      "key": "volunteer_signup",
      "type": "volunteer",
      "name": {
        "en": "Volunteer with us",
        "fr": "Devenir bénévole"
      },
      "fields": [
        "title",
        "email",
        "phone",
        "skills",
        "availability",
        "languages"
      ]
    }
  ],
  "workflows": [
    {
      "key": "new_volunteer",
      "type": "volunteer",
      "name": {
        "en": "New application",
        "fr": "Nouvelle demande"
      },
      "trigger": {
        "on": "created"
      },
      "steps": [
        {
          "kind": "create_task",
          "title": {
            "en": "Review the application and check references",
            "fr": "Examiner la demande et vérifier les références"
          },
          "dueInDays": 3
        }
      ]
    },
    {
      "key": "volunteer_active",
      "type": "volunteer",
      "name": {
        "en": "Volunteer approved",
        "fr": "Bénévole approuvé"
      },
      "trigger": {
        "on": "property_changed",
        "property": "status",
        "to": "active"
      },
      "steps": [
        {
          "kind": "notify",
          "role": "staff",
          "message": {
            "en": "A new volunteer is ready for shifts.",
            "fr": "Un nouveau bénévole peut prendre des quarts."
          }
        }
      ]
    }
  ]
}
